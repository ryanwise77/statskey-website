# Firebase web SDK configuration for the StatsKey web app.
# These values are not secrets — Firebase web API keys are public and access
# is enforced by Firestore security rules and auth-domain allow-listing.
# Defaults in src/app/lib/firebase.ts already point at the existing
# `statskey` project, so this file is only needed to override for staging.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=statskey.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=statskey
VITE_FIREBASE_STORAGE_BUCKET=statskey.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1081412767986
VITE_FIREBASE_APP_ID=
