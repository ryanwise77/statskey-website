# Firebase web SDK configuration for the StatsKey web app.
# These values are not secrets — Firebase web API keys are public and access
# is enforced by Firestore security rules and auth-domain allow-listing.
# Defaults in src/app/lib/firebase.ts already point at the existing
# `statskey` project, so this file is only needed to override for staging.

VITE_FIREBASE_API_KEY=AIzaSyD7b9XKxV0Z7qdcdgMEVuE-fTTIoYsLCpc
VITE_FIREBASE_AUTH_DOMAIN=statskey.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=statskey
VITE_FIREBASE_STORAGE_BUCKET=statskey.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1081412767986
VITE_FIREBASE_APP_ID=1:1081412767986:web:15dbdf5870c78be674c06b
VITE_FIREBASE_APP_CHECK_SITE_KEY=6LdJD3YtAAAAAOFCat_cVqBoWU5G1IL7qDeFUNEp

# Separate high-volume browser Workbench service. It verifies the StatsKey ID
# token but stores GitHub credentials and commit records in statskey-workbench.
VITE_WORKBENCH_API_URL=https://us-central1-statskey-workbench.cloudfunctions.net/workbenchApi
# Credential-free, device-signed Fleet transport. Keep this explicit because
# it may be deployed or rolled back independently from the account API.
VITE_FLEET_DEVICE_API_URL=https://us-central1-statskey-workbench.cloudfunctions.net/workbenchDeviceApi
