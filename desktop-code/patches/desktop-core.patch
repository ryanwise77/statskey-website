+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+export const CodexAccountCommandId = {
+	Read: 'workbench.action.codex.account.read',
+	Activate: 'workbench.action.codex.account.activate',
+	Login: 'workbench.action.codex.account.login',
+	Cancel: 'workbench.action.codex.account.cancel',
+	Logout: 'workbench.action.codex.account.logout',
+} as const;
+
+export interface ICodexAccountLoginCommandResult {
+	readonly loginId: string;
+}
+
+/**
+ * Codex App Server owns the OAuth flow and returns the page that should be
+ * opened in the user's browser. Restrict that handoff to HTTPS origins owned
+ * by OpenAI so a compromised or incompatible runtime cannot redirect account
+ * credentials to another site.
+ */
+export function normalizeTrustedCodexAuthUrl(value: string): string | undefined {
+	try {
+		const url = new URL(value);
+		const hostname = url.hostname.toLowerCase();
+		const isOpenAIHost = hostname === 'openai.com' || hostname.endsWith('.openai.com');
+		const isChatGPTDomain = hostname === 'chatgpt.com' || hostname.endsWith('.chatgpt.com');
+		const trusted = url.protocol === 'https:'
+			&& (url.port === '' || url.port === '443')
+			&& url.username === ''
+			&& url.password === ''
+			&& (isOpenAIHost || isChatGPTDomain);
+		return trusted ? url.href : undefined;
+	} catch {
+		return undefined;
+	}
+}
+
+export function isTrustedCodexAuthUrl(value: string): boolean {
+	return normalizeTrustedCodexAuthUrl(value) !== undefined;
+}

