+/**
+ * Inline code is commonly used by agents as a compatibility fallback when
+ * returning file paths. Keep the heuristic deliberately narrow; candidates
+ * are still resolved through the session and verified with IFileService
+ * before the DOM is changed.
+ */
+export function isLikelyInlineFilePath(value: string): boolean {
+	if (!value || value.length > 4096 || /[\r\n\0?]/.test(value)) {
+		return false;
+	}
+
+	const target = value.trim();
+	if (!target || target !== value) {
+		return false;
+	}
+
+	const isWindowsAbsolutePath = /^[a-zA-Z]:[\\/]/.test(target) || target.startsWith('\\\\');
+	const scheme = /^([a-zA-Z][a-zA-Z0-9+.-]*):/.exec(target)?.[1]?.toLowerCase();
+	if (scheme && !isWindowsAbsolutePath && scheme !== 'file' && scheme !== 'vscode-agent-host') {
+		return false;
+	}
+
+	if (target.includes('/') || target.includes('\\')) {
+		return true;
+	}
+
+	const withoutLocation = target.replace(/:\d+(?::\d+)?$/, '').split('#', 1)[0];
+	const extensionIndex = withoutLocation.lastIndexOf('.');
+	return extensionIndex > 0
+		&& extensionIndex < withoutLocation.length - 1
+		&& /^[a-zA-Z0-9][a-zA-Z0-9_-]{0,15}$/.test(withoutLocation.substring(extensionIndex + 1));
+}
+
+function getDescendantElementsByTagName<K extends keyof HTMLElementTagNameMap>(element: HTMLElement, tagName: K): HTMLElementTagNameMap[K][] {
+	const matches: HTMLElementTagNameMap[K][] = [];
+	const walker = element.ownerDocument.createTreeWalker(element, NodeFilter.SHOW_ELEMENT);
+	while (walker.nextNode()) {
+		const candidate = walker.currentNode as Element;
+		if (candidate.localName === tagName) {
+			matches.push(candidate as HTMLElementTagNameMap[K]);
+		}
+	}
+	return matches;
+}
