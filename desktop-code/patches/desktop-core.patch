+/**
+ * Resolves a schemeless file link against an Agent Host session's working
+ * directory and wraps it for the owning connection. Parent-directory
+ * traversal is intentionally rejected: relative response links must stay
+ * rooted in the session directory, while absolute links continue to be
+ * handled by {@link rewriteAgentHostLinkTarget}.
+ */
+export function rewriteAgentHostRelativeFileLinkTarget(href: string, workingDirectory: URI | undefined, connectionAuthority: string): string {
+	if (!workingDirectory) {
+		return href;
+	}
+
+	const fragmentIndex = href.indexOf('#');
+	const rawPath = fragmentIndex >= 0 ? href.substring(0, fragmentIndex) : href;
+	if (!rawPath || rawPath.includes('?')) {
+		return href;
+	}
+
+	const existingFragment = fragmentIndex >= 0 ? href.substring(fragmentIndex + 1) : '';
+	const parsedPath = existingFragment ? { path: rawPath } : parseFileLocation(rawPath);
+
+	// Anything with a URI scheme (including Windows drive-relative paths such
+	// as C:foo) is not a working-directory-relative file target. Check after
+	// removing a :line[:column] suffix so `README.md:12` stays relative. A
+	// regex is used here because valid relative file names may contain spaces,
+	// which strict URI parsing rejects.
+	if (/^[a-zA-Z][a-zA-Z0-9+.-]*:/.test(parsedPath.path)) {
+		return href;
+	}
+
+	let decodedPath: string;
+	try {
+		decodedPath = decodeURIComponent(parsedPath.path).replaceAll('\\', '/');
+	} catch {
+		return href;
+	}
+
+	if (posix.isAbsolute(decodedPath) || win32.isAbsolute(decodedPath)) {
+		return href;
+	}
+
+	const segments = decodedPath.split('/').filter(segment => segment.length > 0 && segment !== '.');
+	if (segments.length === 0 || segments.some(segment => segment === '..')) {
+		return href;
+	}
+
+	const selectionFragment = formatLocationFragment(parsedPath);
+	try {
+		const hostWorkingDirectory = workingDirectory.scheme === AGENT_HOST_SCHEME ? fromAgentHostUri(workingDirectory) : workingDirectory;
+		return toAgentHostUri(URI.joinPath(hostWorkingDirectory, ...segments).with({ fragment: existingFragment || selectionFragment }), connectionAuthority).toString();
+	} catch {
+		return href;
+	}
+}
