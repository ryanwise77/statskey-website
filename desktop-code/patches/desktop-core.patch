+		}
+		if (resource.scheme !== 'file' && resource.scheme !== 'vscode-agent-host') {
+			return;
+		}
+		if (new URLSearchParams(resource.query).has('vscodeLinkType')) {
+			return;
+		}
+
+		try {
+			const stat = await fileService.stat(resource.with({ fragment: '' }));
