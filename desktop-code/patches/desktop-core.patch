+interface ICloseMatchingBrowserTabsOptions {
+	urlFilter: string;
+	navigateTo?: string;
+	waitForUrlFilter?: string;
+	timeoutMs?: number;
+}
+
+interface ICloseMatchingBrowserTabsResult {
+	closed: number;
+	failed: number;
+}
+
+class CloseMatchingBrowserTabsAction extends Action2 {
+	constructor() {
+		super({
+			id: BrowserViewCommandId.CloseMatching,
+			title: localize2('browser.closeMatching', "Close Matching Browser Tabs"),
+			category: BrowserActionCategory,
+			f1: false,
+		});
+	}
+
+	async run(accessor: ServicesAccessor, input?: string | ICloseMatchingBrowserTabsOptions): Promise<ICloseMatchingBrowserTabsResult> {
+		const options: ICloseMatchingBrowserTabsOptions | undefined = typeof input === 'string'
+			? { urlFilter: input }
+			: input;
+		if (!options?.urlFilter) {
+			return { closed: 0, failed: 0 };
+		}
+		const editorGroupsService = accessor.get(IEditorGroupsService);
+		const matches: Array<{ group: IEditorGroup; editor: BrowserEditorInput }> = [];
+		for (const group of editorGroupsService.getGroups(GroupsOrder.GRID_APPEARANCE)) {
+			for (const editor of group.getEditors(EditorsOrder.SEQUENTIAL)) {
+				if (editor instanceof BrowserEditorInput && matchesBrowserUrlFilter(editor.url, options.urlFilter)) {
+					matches.push({ group, editor });
+				}
+			}
+		}
+
+		const safeToClose = new Set<BrowserEditorInput>();
+		await Promise.all(matches.map(async ({ editor }) => {
+			// Closing an ephemeral session destroys its cookies and origin storage,
+			// so it is safe even when the logout page is unavailable. Persistent
+			// sessions must acknowledge same-origin logout before being closed.
+			if (!options.navigateTo || editor.storageScope === BrowserViewStorageScope.Ephemeral) {
+				safeToClose.add(editor);
+				return;
+			}
+			const acknowledged = await navigateBrowserEditorAndWait(
+				editor,
+				options.navigateTo,
+				options.waitForUrlFilter ?? options.navigateTo,
+				Math.min(Math.max(options.timeoutMs ?? 10_000, 1_000), 30_000),
+			);
+			if (acknowledged) {
+				safeToClose.add(editor);
+			}
+		}));
+
+		let closed = 0;
+		for (const group of editorGroupsService.getGroups(GroupsOrder.GRID_APPEARANCE)) {
+			const browserEditors = matches
+				.filter(match => match.group === group && safeToClose.has(match.editor))
+				.map(match => match.editor);
+			if (browserEditors.length) {
+				await group.closeEditors(browserEditors);
+				closed += browserEditors.length;
+			}
+		}
+		return { closed, failed: matches.length - closed };
+	}
+}
+
+async function navigateBrowserEditorAndWait(editor: BrowserEditorInput, target: string, acknowledgmentFilter: string, timeoutMs: number): Promise<boolean> {
+	try {
+		const model = await editor.resolve();
+		if (matchesBrowserUrlFilter(model.url, acknowledgmentFilter)) {
+			return true;
+		}
+		return await new Promise<boolean>(resolve => {
+			const store = new DisposableStore();
+			let settled = false;
+			const finish = (acknowledged: boolean) => {
+				if (settled) {
+					return;
+				}
+				settled = true;
+				store.dispose();
+				resolve(acknowledged);
+			};
+			store.add(model.onDidNavigate(event => {
+				if (matchesBrowserUrlFilter(event.url, acknowledgmentFilter)) {
+					finish(true);
+				}
+			}));
+			store.add(disposableTimeout(() => finish(false), timeoutMs));
+			editor.navigate(target);
+		});
+	} catch {
+		return false;
+	}
+}
+
+function matchesBrowserUrlFilter(browserUrl: string | undefined, urlFilter: string): boolean {
+	try {
+		const filterUri = URI.parse(urlFilter);
+		const editorUri = URI.parse(browserUrl || '');
+		// URI parsing invents a file scheme for schemeless input. Only compare a
+		// scheme when the caller explicitly supplied one.
+		if (filterUri.scheme && urlFilter.startsWith(`${filterUri.scheme}:`) && filterUri.scheme !== editorUri.scheme) {
+			return false;
+		}
+		if (filterUri.authority && !match(filterUri.authority, editorUri.authority)) {
+			return false;
+		}
+		if (filterUri.path && !match(filterUri.path, editorUri.path)) {
+			return false;
+		}
+		if (filterUri.query) {
+			const filterParams = new URLSearchParams(filterUri.query);
+			const editorParams = new URLSearchParams(editorUri.query);
+			if (![...filterParams].every(([key, value]) => match(value, editorParams.get(key) ?? ''))) {
+				return false;
+			}
+		}
+		return true;
+	} catch {
+		return false;
+	}
+}
