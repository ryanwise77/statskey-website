+
+import assert from 'assert';
+import { Event } from '../../../../../base/common/event.js';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../../../base/test/common/utils.js';
+import { BrowserViewStorageScope } from '../../../../../platform/browserView/common/browserView.js';
+import { BrowserEditorInput, BrowserEditorSerializer, IBrowserEditorInputData } from '../../common/browserEditorInput.js';
+
+suite('BrowserEditorInput', () => {
+	ensureNoDisposablesAreLeakedInTestSuite();
+
+	test('preserves ephemeral storage through lazy navigation and state projections', () => {
+		const copiedStates: IBrowserEditorInputData[] = [];
+		let input: BrowserEditorInput;
+		const instantiationService = {
+			invokeFunction: (callback: (accessor: { get: () => unknown }) => unknown) => callback({
+				get: () => ({
+					getOrCreateLazy: (_id: string, state: IBrowserEditorInputData) => {
+						copiedStates.push(state);
+						return input;
+					},
+				}),
+			}),
+		};
+		input = new BrowserEditorInput(
+			{
+				id: 'private-browser',
+				url: 'https://statskey.ai/app/enterprise',
+				storageScope: BrowserViewStorageScope.Ephemeral,
+			},
+			async () => { throw new Error('model should remain lazy'); },
+			{} as never,
+			instantiationService as never,
+			{ publicLog2() { } } as never,
+			{} as never,
+		);
+
+		input.navigate('https://statskey.ai/app/tokens');
+		assert.strictEqual(input.storageScope, BrowserViewStorageScope.Ephemeral);
+		assert.strictEqual(input.serialize().storageScope, BrowserViewStorageScope.Ephemeral);
+		assert.strictEqual(
+			(input.toUntyped().options?.viewState as IBrowserEditorInputData).storageScope,
+			BrowserViewStorageScope.Ephemeral,
+		);
+
+		input.copy();
+		assert.strictEqual(copiedStates[0].storageScope, BrowserViewStorageScope.Ephemeral);
+
+		const serialized = new BrowserEditorSerializer().serialize(input);
+		assert.ok(serialized);
+		assert.strictEqual(
+			(JSON.parse(serialized) as IBrowserEditorInputData).storageScope,
+			BrowserViewStorageScope.Ephemeral,
+		);
+
+		input.model = {
+			url: 'https://statskey.ai/app/tokens',
+			title: 'Credits',
+			favicon: undefined,
+			storageScope: BrowserViewStorageScope.Ephemeral,
+			onWillDispose: Event.None,
+			onDidClose: Event.None,
+			onDidChangeTitle: Event.None,
+			onDidChangeFavicon: Event.None,
+			onDidChangeLoadingState: Event.None,
+			onDidNavigate: Event.None,
+			dispose() { },
+		} as never;
+		input.dispose();
+		assert.strictEqual(input.serialize().storageScope, BrowserViewStorageScope.Ephemeral);
+	});
+});

