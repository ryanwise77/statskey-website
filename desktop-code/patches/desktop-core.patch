+/**
+ * Turns verified inline-code file paths into rich resource anchors. This is
+ * intentionally asynchronous so nonexistent paths, folders, and unresolved
+ * relative targets stay as ordinary code.
+ */
+export async function decorateInlineFileCodeSpans(element: HTMLElement, sessionResource: URI, chatSessionsService: IChatSessionsService, fileService: IFileService): Promise<number> {
+	const candidates = getDescendantElementsByTagName(element, 'code')
+		.filter(code => !code.closest('pre, a'))
+		.slice(0, 32);
+
+	let decorated = 0;
+	await Promise.all(candidates.map(async code => {
+		const target = code.textContent ?? '';
+		if (!isLikelyInlineFilePath(target)) {
+			return;
+		}
+
+		let resource: URI;
+		try {
+			const resolved = chatSessionsService.resolveChatResponseUri(sessionResource, target, 'link');
+			resource = URI.parse(resolved, true);
+		} catch {
+			return;
+		}
+
+		if (resource.scheme !== 'file' && resource.scheme !== 'vscode-agent-host') {
+			return;
+		}
+		if (new URLSearchParams(resource.query).has('vscodeLinkType')) {
+			return;
+		}
+
+		try {
+			const stat = await fileService.stat(resource.with({ fragment: '' }));
+			if (stat.isDirectory) {
+				return;
+			}
+		} catch {
+			return;
+		}
+
+		if (!element.contains(code)) {
+			return;
+		}
+
+		const query = new URLSearchParams(resource.query);
+		query.set('vscodeLinkType', 'file');
+		const anchor = dom.$('a');
+		anchor.textContent = target;
+		anchor.setAttribute('data-href', resource.with({ query: query.toString() }).toString());
+		code.replaceWith(anchor);
+		decorated++;
+	}));
+
+	return decorated;
+}
