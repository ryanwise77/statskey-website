+
+import assert from 'assert';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../../../base/test/common/utils.js';
+import { CodexAccountCommandId, isTrustedCodexAuthUrl, normalizeTrustedCodexAuthUrl } from '../../common/codexAccountCommands.js';
+
+suite('Codex account commands', () => {
+
+	ensureNoDisposablesAreLeakedInTestSuite();
+
+	test('uses stable internal command identifiers', () => {
+		assert.deepStrictEqual(CodexAccountCommandId, {
+			Read: 'workbench.action.codex.account.read',
+			Activate: 'workbench.action.codex.account.activate',
+			Login: 'workbench.action.codex.account.login',
+			Cancel: 'workbench.action.codex.account.cancel',
+			Logout: 'workbench.action.codex.account.logout',
+		});
+	});
+
+	test('accepts HTTPS OpenAI and ChatGPT authentication origins', () => {
+		for (const value of [
+			'https://auth.openai.com/oauth/authorize?client_id=codex',
+			'https://platform.openai.com/',
+			'https://chatgpt.com/auth/callback',
+			'https://auth.chatgpt.com:443/oauth/authorize',
+		]) {
+			assert.strictEqual(isTrustedCodexAuthUrl(value), true, value);
+		}
+	});
+
+	test('opens the same normalized URL that passed origin validation', () => {
+		assert.strictEqual(
+			normalizeTrustedCodexAuthUrl('https://auth.openai.com\\@evil.example/path'),
+			'https://auth.openai.com/@evil.example/path',
+		);
+	});
+
+	test('rejects non-HTTPS, misleading, credentialed, and nonstandard-port origins', () => {
+		for (const value of [
+			'http://auth.openai.com/oauth/authorize',
+			'https://auth.openai.com:8443/oauth/authorize',
+			'https://openai.com.evil.example/oauth/authorize',
+			'https://evilopenai.com/oauth/authorize',
+			'https://chatgpt.com@evil.example/oauth/authorize',
+			'https://user:password@auth.openai.com/oauth/authorize',
+			'https://localhost/oauth/authorize',
+			'javascript:alert(1)',
+			'not a URL',
+		]) {
+			assert.strictEqual(isTrustedCodexAuthUrl(value), false, value);
+		}
+	});
+});
