+	private async _signIn(agentHostService: IAgentHostService, notificationService: INotificationService, commandService: ICommandService, progressService: IProgressService): Promise<void> {
+		if (!agentHostService.getProviderAccount || !agentHostService.cancelProviderAccountLogin) {
+			throw new Error(localize('codexOpenAIAccount.loginUnavailable', "OpenAI account login is unavailable for this agent host."));
+		}
+		const getAccount = agentHostService.getProviderAccount.bind(agentHostService);
+		const cancelLogin = agentHostService.cancelProviderAccountLogin.bind(agentHostService);
+		const login = await commandService.executeCommand<ICodexAccountLoginCommandResult>(CodexAccountCommandId.Login);
+		if (!login) {
+			throw new Error(localize('codexOpenAIAccount.loginFailedToStart', "OpenAI sign-in could not be started."));
+		}
+
+		const cancellation = new CancellationTokenSource();
+		let signedIn = false;
+		try {
+			await progressService.withProgress({
+				location: ProgressLocation.Notification,
+				title: localize('codexOpenAIAccount.waiting', "Complete OpenAI sign-in in your browser"),
+				cancellable: true,
+			}, async () => {
+				const deadline = Date.now() + 10 * 60 * 1000;
+				while (!cancellation.token.isCancellationRequested && Date.now() < deadline) {
+					const account = await getAccount(CODEX_AGENT_PROVIDER_ID);
+						if (account.status === 'signedIn' && account.active) {
+						signedIn = true;
+						return;
+					}
+					if (account.status === 'error') {
+						throw new Error(account.error ?? localize('codexOpenAIAccount.failed', "OpenAI sign-in failed."));
+					}
+					await timeout(1000, cancellation.token);
+				}
+				if (!cancellation.token.isCancellationRequested) {
+					throw new Error(localize('codexOpenAIAccount.timedOut', "OpenAI sign-in timed out. Run the account command to try again."));
+				}
+			}, () => cancellation.cancel());
+		} finally {
+			cancellation.dispose();
+			if (!signedIn) {
+				try {
+					await cancelLogin(CODEX_AGENT_PROVIDER_ID, login.loginId);
+				} catch {
+					// Preserve the original failure or cancellation shown to the user.
+				}
+			}
+		}
+		if (signedIn) {
+			notificationService.info(localize('codexOpenAIAccount.complete', "Signed in to OpenAI. Codex will use the models and limits included with your ChatGPT plan."));
+		}
+	}
+});
