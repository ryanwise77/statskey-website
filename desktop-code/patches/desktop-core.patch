+			return;
+		}
+		const confirmation = await dialogService.confirm({
+			type: 'warning',
+			message: localize('codexOpenAIAccount.confirmSignOut', "Log out of Codex?"),
+			detail: localize('codexOpenAIAccount.confirmSignOutDetail', "This removes the OpenAI account from the local Codex credential store. Other local Codex clients that share this store may also require sign-in again."),
