    "test:founder-history": "node --test scripts/founder-history-lib.test.mjs",
    "test:founder-nutrition": "node --test scripts/founder-nutrition-fallback.test.mjs scripts/founder-nutrition-ui.test.mjs",
    "test:firestore-failover": "node --test scripts/firestore-failover.test.ts",
