{
  "name": "website",
  "private": true,
  "version": "0.19.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:desktop": "vite build --mode desktop",
    "build:founder-history": "node scripts/build-founder-history.mjs",
    "refresh:founder-history": "node scripts/refresh-founder-history.mjs",
    "test:founder-history": "node --test scripts/founder-history-lib.test.mjs",
    "test:health": "vitest run src/app/lib/healthInsights.test.ts src/app/lib/data/useSleepSessions.test.ts src/app/lib/assistant/calendarIcs.test.ts src/app/lib/agentLocalState.test.ts",
    "preview": "vite preview",
    "check:deploy": "node scripts/check-deploy-ready.mjs",
    "release:desktop:prepare": "node desktop/prepare-update.cjs",
    "release:desktop:local": "npm --prefix desktop run release:local:mac",
    "release:desktop:ship": "node desktop/ship-mac-update.cjs --confirm-publish",
    "release:desktop:install": "node desktop/ship-mac-update.cjs --install-only",
    "release:desktop:publish:windows-preview": "node desktop/publish-update.cjs --confirm-publish --windows-only --preview --reuse-build",
    "build:desktop:linux:x64": "npm --prefix desktop run build:linux:x64",
    "release:desktop:prepare:linux-preview": "node desktop/publish-update.cjs --prepare-only --linux-only --preview",
    "release:desktop:publish:linux-preview": "node desktop/publish-update.cjs --confirm-publish --linux-only --preview --reuse-build",
    "test:desktop:release": "vitest run src/app/lib/ai/agentRoundTools.test.ts src/app/lib/ai/subagentModel.test.ts src/app/lib/ai/providerRequest.test.ts src/app/lib/ai/providerWatchdog.test.ts src/app/lib/ai/agentRevealAnswer.test.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.0",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.2.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "firebase": "^12.17.0",
    "leaflet": "^1.9.4",
    "manifold-3d": "^3.5.1",
    "monaco-editor": "^0.53.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.18.2",
    "three": "^0.185.1"
  }
}
